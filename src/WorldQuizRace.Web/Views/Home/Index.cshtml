@{
    ViewData["Title"] = "Accueil";
}

<section class="wqr-hero text-center">
    <div class="wqr-hero-markers" aria-hidden="true">
        <span class="wqr-marker wqr-marker-a">A</span>
        <span class="wqr-marker wqr-marker-destination">★</span>
        <span class="wqr-marker wqr-marker-b">B</span>
    </div>

    <h1 class="wqr-title">World Quiz Race</h1>
    <p class="wqr-subtitle">
        Deux explorateurs, deux routes, une seule destination.
        Relève les défis pour avancer sur la carte du monde !
    </p>

    @* Bouton provisoire : branché sur l'écran d'inscription en phase 4. *@
    <button type="button" class="btn wqr-btn-primary btn-lg" disabled aria-disabled="true"
            title="Bientôt disponible">
        Nouvelle partie
    </button>
</section>
