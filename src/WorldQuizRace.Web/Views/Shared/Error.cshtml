@model ErrorViewModel
@{
    ViewData["Title"] = "Oups";
}

<section class="wqr-hero text-center">
    <h1>Oups, petit détour imprévu !</h1>
    <p class="wqr-subtitle">Quelque chose s'est mal passé. Reviens à l'accueil pour reprendre l'aventure.</p>
    <a class="btn wqr-btn-primary" asp-controller="Home" asp-action="Index">Retour à l'accueil</a>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4 small text-muted">Référence : <code>@Model.RequestId</code></p>
    }
</section>
