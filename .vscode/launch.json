{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "World Quiz Race (Web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/WorldQuizRace.Web/bin/Debug/net10.0/WorldQuizRace.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/WorldQuizRace.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7243;http://localhost:5255"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/WorldQuizRace.Web/Views"
      }
    }
  ]
}
